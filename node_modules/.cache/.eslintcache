ErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"101","usedDeprecatedRules":"51"},{"filePath":"102","messages":"103","suppressedMessages":"104","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},{"filePath":"105","messages":"106","suppressedMessages":"107","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"108","messages":"109","suppressedMessages":"110","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"111","messages":"112","suppressedMessages":"113","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"114","messages":"115","suppressedMessages":"116","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"117","messages":"118","suppressedMessages":"119","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},"/Users/mac/Documents/ReactJS/bae-link/src/index.js",[],[],[],"/Users/mac/Documents/ReactJS/bae-link/src/serviceWorker.js",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/App.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/navigation.jsx",["120"],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/header.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/features.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/portmeirion.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/gallery.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/services.jsx",[],[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/lecreuset.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/promotion.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/smeg.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/contact.jsx",["121"],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/poster.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/testimonials.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/image.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/pages/discovery.jsx",["122"],[],"import React, { useEffect, useState } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport { Navigation } from \"../components/navigation\";\nimport { Team } from \"../components/team\";\nimport { About } from \"../components/about\";\nimport { Testimonials } from \"../components/testimonials\";\nimport JsonData from \"../data/data.json\";\n\nimport \"../App.css\";\n\nconst Section = ({ id, title, children }) => (\n  <section id={id} className=\"section-wrapper\">\n    {title && <h2 className=\"section-title\">{title}</h2>}\n    {children}\n  </section>\n);\n\nexport const Discovery = () => {\n  const [data, setData] = useState({});\n  const location = useLocation();\n\n  // Load JSON data once\n  useEffect(() => {\n    setData(JsonData);\n  }, []);\n\n  // Handle hash scroll after data is loaded and DOM is ready\n  useEffect(() => {\n    if (location.hash) {\n      const sectionId = location.hash.substring(1);\n      const scrollToSection = () => {\n        const sectionEl = document.getElementById(sectionId);\n        if (sectionEl) {\n          sectionEl.scrollIntoView({ behavior: \"smooth\" });\n        } else {\n          // Retry after delay if not ready\n          setTimeout(scrollToSection, 100);\n        }\n      };\n      scrollToSection();\n    }\n  }, [location.hash, data]);\n\n  return (\n    <div id=\"discovery\">\n      <Navigation data={data?.Navigation} />\n\n      <Section id=\"testimonials\">\n        <Testimonials data={data?.Testimonials} />\n      </Section>\n      \n      <Section id=\"about\">\n        <About data={data?.About} />\n      </Section>\n\n    </div>\n  );\n};\n\nexport default Discovery;\n","/Users/mac/Documents/ReactJS/bae-link/src/components/scrollToTop.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/pages/brands.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/staub.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/brandSection.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/about.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/team.jsx",[],[],{"ruleId":"123","severity":1,"message":"124","line":2,"column":10,"nodeType":"125","messageId":"126","endLine":2,"endColumn":13},{"ruleId":"127","severity":1,"message":"128","line":24,"column":5,"nodeType":"129","messageId":"130","endLine":24,"endColumn":106},{"ruleId":"123","severity":1,"message":"131","line":4,"column":10,"nodeType":"125","messageId":"126","endLine":4,"endColumn":14},"no-unused-vars","'Nav' is defined but never used.","Identifier","unusedVar","no-lone-blocks","Nested block is redundant.","BlockStatement","redundantNestedBlock","'Team' is defined but never used."]