:0,"usedDeprecatedRules":"51"},{"filePath":"96","messages":"97","suppressedMessages":"98","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},{"filePath":"99","messages":"100","suppressedMessages":"101","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"102","usedDeprecatedRules":"51"},{"filePath":"103","messages":"104","suppressedMessages":"105","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},{"filePath":"106","messages":"107","suppressedMessages":"108","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},{"filePath":"109","messages":"110","suppressedMessages":"111","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},{"filePath":"112","messages":"113","suppressedMessages":"114","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},{"filePath":"115","messages":"116","suppressedMessages":"117","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},{"filePath":"118","messages":"119","suppressedMessages":"120","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"51"},"/Users/mac/Documents/ReactJS/bae-link/src/index.js",[],[],[],"/Users/mac/Documents/ReactJS/bae-link/src/serviceWorker.js",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/App.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/navigation.jsx",["121","122"],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/header.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/features.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/portmeirion.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/gallery.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/services.jsx",[],[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/lecreuset.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/promotion.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/smeg.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/contact.jsx",["123"],[],"import { useState } from \"react\";\nimport emailjs from \"emailjs-com\";\nimport React from \"react\";\n\nconst initialState = {\n  name: \"\",\n  email: \"\",\n  message: \"\",\n};\nexport const Contact = (props) => {\n  const [{ name, email, message }, setState] = useState(initialState);\n\n  const handleChange = (e) => {\n    const { name, value } = e.target;\n    setState((prevState) => ({ ...prevState, [name]: value }));\n  };\n  const clearState = () => setState({ ...initialState });\n  \n  \n  const handleSubmit = (e) => {\n    e.preventDefault();\n    console.log(name, email, message);\n    \n    {/* replace below with your own Service ID, Template ID and Public Key from your EmailJS account */ }\n    \n    emailjs\n      .sendForm(\"YOUR_SERVICE_ID\", \"YOUR_TEMPLATE_ID\", e.target, \"YOUR_PUBLIC_KEY\")\n      .then(\n        (result) => {\n          console.log(result.text);\n          clearState();\n        },\n        (error) => {\n          console.log(error.text);\n        }\n      );\n  };\n  return (\n    <div>\n      <div id=\"contact\">\n        <div className=\"container\">\n          <div className=\"col-md-8\">\n            <div className=\"row\">\n              <div className=\"section-title\">\n                <h2 className=\"exclusive-title\">Get in Touch with Us</h2>\n                <p>\n                  Have questions? Ready to start your personalized shopping experience? We’d love to hear from you!\n                </p>\n              </div>\n              <form name=\"sentMessage\" validate onSubmit={handleSubmit}>\n                <div className=\"row\">\n                  <div className=\"col-md-6\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"text\"\n                        id=\"name\"\n                        name=\"name\"\n                        className=\"form-control\"\n                        placeholder=\"Name\"\n                        required\n                        onChange={handleChange}\n                      />\n                      <p className=\"help-block text-danger\"></p>\n                    </div>\n                  </div>\n                  <div className=\"col-md-6\">\n                    <div className=\"form-group\">\n                      <input\n                        type=\"email\"\n                        id=\"email\"\n                        name=\"email\"\n                        className=\"form-control\"\n                        placeholder=\"Email\"\n                        required\n                        onChange={handleChange}\n                      />\n                      <p className=\"help-block text-danger\"></p>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"form-group\">\n                  <textarea\n                    name=\"message\"\n                    id=\"message\"\n                    className=\"form-control\"\n                    rows=\"4\"\n                    placeholder=\"Message\"\n                    required\n                    onChange={handleChange}\n                  ></textarea>\n                  <p className=\"help-block text-danger\"></p>\n                </div>\n                <div id=\"success\"></div>\n                <button type=\"submit\" className=\"btn btn-custom btn-lg\">\n                  Send Message\n                </button>\n              </form>\n            </div>\n          </div>\n          <div className=\"col-md-3 col-md-offset-1 contact-info\">\n            <div className=\"contact-item\">\n              <h3>Contact Info</h3>\n              <p>\n                <span>\n                  <i className=\"fa fa-map-marker\"></i> Address\n                </span>\n                {props.data ? props.data.address : \"loading\"}\n              </p>\n            </div>\n            <div className=\"contact-item\">\n              <p>\n                <span>\n                  <i className=\"fa fa-phone\"></i> Phone\n                </span>{\" \"}\n                {props.data ? props.data.phone : \"loading\"}\n              </p>\n            </div>\n            <div className=\"contact-item\">\n              <p>\n                <span>\n                  <i className=\"fa fa-envelope-o\"></i> Email\n                </span>{\" \"}\n                {props.data ? props.data.email : \"loading\"}\n              </p>\n            </div>\n          </div>\n          <div className=\"col-md-12\">\n            <div className=\"row\">\n              <div className=\"social\">\n                <ul>\n                  <li>\n                    <a href={props.data ? props.data.facebook : \"/\"}>\n                      <i className=\"fa fa-facebook\"></i>\n                    </a>\n                  </li>\n                  <li>\n                    <a href={props.data ? props.data.twitter : \"/\"}>\n                      <i className=\"fa fa-twitter\"></i>\n                    </a>\n                  </li>\n                  <li>\n                    <a href={props.data ? props.data.youtube : \"/\"}>\n                      <i className=\"fa fa-youtube\"></i>\n                    </a>\n                  </li>\n                </ul>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div id=\"footer\">\n        <div className=\"container text-center\">\n          <p>\n            &copy; 2025 thewholestory.shop\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n};\n","/Users/mac/Documents/ReactJS/bae-link/src/components/poster.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/testimonials.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/image.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/pages/discovery.jsx",["124"],[],"import React, { useEffect, useState } from \"react\";\nimport { useLocation } from \"react-router-dom\";\nimport { Navigation } from \"../components/navigation\";\nimport { Team } from \"../components/team\";\nimport { About } from \"../components/about\";\nimport { Testimonials } from \"../components/testimonials\";\nimport JsonData from \"../data/data.json\";\n\nimport \"../App.css\";\n\nconst Section = ({ id, title, children }) => (\n  <section id={id} className=\"section-wrapper\">\n    {title && <h2 className=\"section-title\">{title}</h2>}\n    {children}\n  </section>\n);\n\nexport const Discovery = () => {\n  const [data, setData] = useState({});\n  const location = useLocation();\n\n  // Load JSON data once\n  useEffect(() => {\n    setData(JsonData);\n  }, []);\n\n  // Handle hash scroll after data is loaded and DOM is ready\n  useEffect(() => {\n    if (location.hash) {\n      const sectionId = location.hash.substring(1);\n      const scrollToSection = () => {\n        const sectionEl = document.getElementById(sectionId);\n        if (sectionEl) {\n          sectionEl.scrollIntoView({ behavior: \"smooth\" });\n        } else {\n          // Retry after delay if not ready\n          setTimeout(scrollToSection, 100);\n        }\n      };\n      scrollToSection();\n    }\n  }, [location.hash, data]);\n\n  return (\n    <div id=\"discovery\">\n      <Navigation data={data?.Navigation} />\n\n      <Section id=\"testimonials\">\n        <Testimonials data={data?.Testimonials} />\n      </Section>\n      \n      <Section id=\"about\">\n        <About data={data?.About} />\n      </Section>\n\n    </div>\n  );\n};\n\nexport default Discovery;\n","/Users/mac/Documents/ReactJS/bae-link/src/components/scrollToTop.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/pages/brands.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/staub.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/brandSection.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/about.jsx",[],[],"/Users/mac/Documents/ReactJS/bae-link/src/components/team.jsx",[],[],{"ruleId":"125","severity":1,"message":"126","line":7,"column":10,"nodeType":"127","messageId":"128","endLine":7,"endColumn":21},{"ruleId":"125","severity":1,"message":"129","line":35,"column":9,"nodeType":"127","messageId":"128","endLine":35,"endColumn":19},{"ruleId":"130","severity":1,"message":"131","line":24,"column":5,"nodeType":"132","messageId":"133","endLine":24,"endColumn":106},{"ruleId":"125","severity":1,"message":"134","line":4,"column":10,"nodeType":"127","messageId":"128","endLine":4,"endColumn":14},"no-unused-vars","'currentHash' is assigned a value but never used.","Identifier","unusedVar","'scrollLink' is assigned a value but never used.","no-lone-blocks","Nested block is redundant.","BlockStatement","redundantNestedBlock","'Team' is defined but never used."]